# Copy to .env — this file is safe to commit; .env is not.
#
# Gemini API key — free-tier fallback for vision + embeddings when LM Studio is offline.
# Get a free key at https://aistudio.google.com/
# Leave blank to disable Gemini (then LM Studio must be running for indexing).
GEMINI_API_KEY=

# Optional process environment overrides (set before starting Python):
# PHOTO_VAULT_DATA_DIR=/absolute/path/to/vault-data
# PHOTO_VAULT_ENV_FILE=- disables loading .env for an isolated preview or test.
# PHOTO_VAULT_PORT=8768 overrides the optional workspace port registry.
